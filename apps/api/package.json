{
  "name": "@video-to-doc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --target node22 --out-dir dist --sourcemap",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "invite:add": "tsx src/invite.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/s3-request-presigner": "^3.817.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.7.0",
    "@video-to-doc/contracts": "workspace:*",
    "@video-to-doc/core": "workspace:*",
    "bullmq": "^5.53.0",
    "cookie-parser": "^1.4.7",
    "docx": "^9.5.0",
    "jsonwebtoken": "^9.0.2",
    "ioredis": "^5.6.0",
    "nodemailer": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.7.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "vitest": "^3.2.0"
  }
}

{
  "name": "@video-to-doc/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --target node22 --out-dir dist --sourcemap",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@prisma/client": "^6.7.0",
    "@video-to-doc/contracts": "workspace:*",
    "@video-to-doc/core": "workspace:*",
    "bullmq": "^5.53.0",
    "docx": "^9.5.0",
    "ioredis": "^5.6.0",
    "openai": "^5.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "vitest": "^3.2.0"
  }
}
